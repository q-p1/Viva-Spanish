# VIVA AI Gateway — server-side secrets only. Never put these in frontend JavaScript.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# Optional model overrides
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.5-flash
OPENROUTER_MODEL=openrouter/free
HF_MODEL=google/gemma-2-2b-it:fastest

# Provider failover order
VIVA_AI_PROVIDER_ORDER=groq,gemini,openrouter,huggingface

# Local gateway
VIVA_AI_PORT=8787
VIVA_ALLOWED_ORIGIN=http://localhost:4173
